make_simple_boxplot <- function(data, varname, title_label) {
vals    <- suppressWarnings(as.numeric(as.character(data[[varname]])))
grps    <- factor(as.character(data$CONDITION_prevalence),
levels = GROUP_LEVELS)
df_plot <- data.frame(Group = grps, Value = vals,
stringsAsFactors = FALSE) %>%
filter(!is.na(Value), !is.na(Group)) %>%
mutate(Group = droplevels(Group))
if (nrow(df_plot) < 10) {
message(sprintf("  SKIP %s — not enough data", varname))
return(NULL)
}
# Kruskal-Wallis
kw_p <- tryCatch({
kruskal.test(Value ~ Group, data = df_plot)$p.value
}, error = function(e) NA)
# Dunn post-hoc
dunn_res <- tryCatch({
df_plot %>%
dunn_test(Value ~ Group, p.adjust.method = "BH") %>%
filter(p.adj < 0.05) %>%
add_significance() %>%
add_xy_position(x = "Group", fun = "max", step.increase = 0.12)
}, error = function(e) NULL)
# C5 flag (diamanti, marker più grandi)
is_c5  <- as.character(df_plot$Group) == "C5"
shapes <- ifelse(is_c5, 18, 16)
sizes  <- ifelse(is_c5, 4,  1.5)
alphas <- ifelse(is_c5, 1,  0.4)
df_plot$is_c5  <- is_c5
df_plot$shapes <- shapes
df_plot$sizes  <- sizes
df_plot$alphas <- alphas
subtitle_txt <- if (!is.na(kw_p)) {
paste0("Kruskal-Wallis p = ", signif(kw_p, 3))
} else "Kruskal-Wallis: NA"
p <- ggboxplot(df_plot, x="Group", y="Value",
color="Group", palette=PAL,
add="jitter", add.params=list(size=1.5, alpha=0.35),
outlier.shape=NA, width=0.5) +
scale_color_manual(values=PAL, guide="none") +
scale_y_continuous(expand=expansion(mult=c(0.05,0.30))) +
labs(title=title_label, subtitle=subtitle_txt, x=NULL, y="Value") +
theme_bw(base_size=11) +
theme(axis.text.x   = element_text(angle=35, hjust=1),
plot.title    = element_text(face="bold", size=11),
plot.subtitle = element_text(size=8, color="grey40"),
legend.position = "none")
if (!is.null(dunn_res) && nrow(dunn_res) > 0) {
p <- p + stat_pvalue_manual(dunn_res, label="p.adj.signif",
tip.length=0.01, size=3.5)
}
p
}
vars <- c(
setNames(paste0(GENES_TRX, " [Trx/transcript]"), GENES_TRX),
setNames(
ifelse(!is.na(PEAK_LABELS[peaks_pos]), PEAK_LABELS[peaks_pos], peaks_pos),
peaks_pos
),
setNames(
ifelse(!is.na(PEAK_LABELS[peaks_neg]), PEAK_LABELS[peaks_neg], peaks_neg),
peaks_neg
)
)
pdf(file.path(PATH_OUTPUT, "Boxplot_Thioredoxin_C5.pdf"),
width = 8, height = 6)
plot_buffer <- list()
for (i in seq_along(vars)) {
varname <- names(vars)[i]
label   <- vars[i]
if (!varname %in% colnames(df_all)) {
message(sprintf("  SKIP %s", varname)); next
}
p <- make_simple_boxplot(df_all, varname, label)
if (!is.null(p)) {
plot_buffer[[length(plot_buffer) + 1]] <- p
message(sprintf("  ✓ %s", label))
}
if (length(plot_buffer) == PLOTS_PER_PAGE) {
grid.arrange(grobs = plot_buffer, ncol = NCOL_PAGE, nrow = NROW_PAGE,
top = "Thioredoxin/Peroxiredoxin axis (Trx)")
plot_buffer <- list()
}
}
if (length(plot_buffer) > 0) {
grid.arrange(grobs = plot_buffer, ncol = NCOL_PAGE,
top = "Thioredoxin/Peroxiredoxin axis (Trx)")
}
dev.off()
message("\n✓ Saved: Boxplot_Thioredoxin_C5.pdf")
message("  Groups: C1, C2, C3, C4, C5 (= C1_prev + C2_prev)")
message("  Stats: Kruskal-Wallis + Dunn post-hoc (BH), shown when p.adj < 0.05")
message("\nObjects in memory: df_all, vars")
